digraph ReproductiveCareSystem {

  graph [label="Access to Reproductive Care Including Abortion\nSystem Map & Causal Loop Diagram (Group 3 - Module 4)", labelloc=t, fontsize=16, fontname="Helvetica-Bold", splines=true, overlap=false];
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10, penwidth=2.0];
  edge [fontname="Helvetica-Bold", fontsize=9];

  // --------------------------------------------------------------------------
  // CENTRAL TARGET OUTCOME NODE (Shared Outcome Node)
  // --------------------------------------------------------------------------
  access_to_care [
    label="Access to reproductive care &\nabortion for pregnant women (14-44)\n[CENTRAL TARGET OUTCOME]",
    shape=doubleoctagon,
    style="filled,rounded",
    fillcolor="#FFCDD2",
    color="#B71C1C",
    penwidth=3.0,
    fontsize=11
  ];

  // --------------------------------------------------------------------------
  // LOOP R1 NODES: Financial Burden & Geographic Travel Loop (Adopted from Mitchel)
  // --------------------------------------------------------------------------
  income_security [label="Income security\n(Structural Determinants)", style="filled,rounded", fillcolor="#EEEAFB", color="#5B50A5"];
  household_out_of_pocket_spending [label="Household out-of-pocket spending for reproductive care\n(Funding)", style="filled,rounded", fillcolor="#EAF3FB", color="#244C6A"];
  out_of_state_travel_burden [label="Out-of-state travel burden\n(New: Geographic Access)", style="filled,rounded", fillcolor="#FCE8E6", color="#A52714"];

  // --------------------------------------------------------------------------
  // LOOP B2 NODES: Infrastructure & Reimbursement Burden Loop (Arelie Orozco)
  // --------------------------------------------------------------------------
  obstetric_maternity_care_availability [label="Obstetric/maternity care availability\n(Infrastructure)", style="filled,rounded", fillcolor="#EBF7ED", color="#2E6B38"];
  medical_device_availability [label="Medical device availability\n(Pharmaceuticals & Devices)", style="filled,rounded", fillcolor="#FFF3E0", color="#E65100"];
  reimbursement_requirements [label="Reimbursement requirements\n(Enforcement & Accountability)", style="filled,rounded", fillcolor="#EBF7ED", color="#2E6B38"];

  // OTHER APPROVED TEMPLATE ELEMENTS
  occupational_stratification_by_race_gender [label="Occupational stratification by race and gender\n(Structural Inequities)", style="filled,rounded", fillcolor="#EEEAFB", color="#5B50A5"];
  medicaid_enrollment [label="Medicaid enrollment among pregnant women ages 14-44\n(Financing / Insurance)", style="filled,rounded", fillcolor="#EAF3FB", color="#244C6A"];
  bundled_payment_use [label="Bundled payment use\n(Payment Models)", style="filled,rounded", fillcolor="#EAF3FB", color="#244C6A"];
  state_scope_of_practice_laws [label="State scope-of-practice laws\n(Federal & State Policy)", style="filled,rounded", fillcolor="#EEEAFB", color="#5B50A5"];
  primary_care_clinician_supply [label="Primary care clinician supply\n(Workforce)", style="filled,rounded", fillcolor="#EBF7ED", color="#2E6B38"];
  specialty_care_referral_availability [label="Specialty care referral availability\n(Care Providers)", style="filled,rounded", fillcolor="#EBF7ED", color="#2E6B38"];
  health_communication_effectiveness [label="Health communication effectiveness\n(Public Health)", style="filled,rounded", fillcolor="#FFF3E0", color="#E65100"];

  // NEW PROPOSED ELEMENTS: Abortion fund capacity (R2 and R3) and policy advocacy (B1)
  abortion_fund_capacity [label="Abortion fund capacity\n(New: Funding / Practical Support)", style="filled,rounded", fillcolor="#FCE8E6", color="#A52714"];

  policy_advocacy [label="Policy advocacy\n(New: Public Health)", style="filled,rounded", fillcolor="#FFF3E0", color="#E65100"];

  // NEW ELEMENTS ADDED FOR SIENNA'S R2
  difficulty_raising_funds [label="Difficulty raising funds for abortion care\n(New: Financing / Access)", style="filled,rounded", fillcolor="#FCE8E6", color="#A52714"];
  abortion_care_delay [label="Delay in obtaining abortion care\n(New: Care Access)", style="filled,rounded", fillcolor="#FCE8E6", color="#A52714"];

  // LOOP R1 (Mitchel Gonzalez)
  income_security -> household_out_of_pocket_spending [label="-", color="#5B50A5", penwidth=2.5, comment="[Mitchel Gonzalez - R1] Lower income security increases out-of-pocket care costs (Guttmacher 2023)"];
  household_out_of_pocket_spending -> out_of_state_travel_burden [label="+ (delay)", color="#A52714", penwidth=2.5, comment="[Mitchel Gonzalez - R1] High upfront costs delay travel arrangements (ANSIRH 2024)"];
  out_of_state_travel_burden -> specialty_care_referral_availability [label="-", color="#A52714", penwidth=2.5, comment="[Mitchel Gonzalez - R1] Travel barriers prevent specialty referral completion (ANSIRH 2024)"];
  specialty_care_referral_availability -> income_security [label="+ (delay)", color="#2E6B38", penwidth=2.5, comment="[Mitchel Gonzalez - R1] Timely care prevents long employment disruptions (ACOG 2023)"];

  // LOOP B1 (Brooke Granger)
  state_scope_of_practice_laws -> primary_care_clinician_supply [label="+", xlabel="B1: Balancing loop", color="#5B50A5", penwidth=2.5, comment="[Brooke Granger - B1] Supportive scope laws permit APCs to provide care (ACOG 2023)"];
  primary_care_clinician_supply -> specialty_care_referral_availability [label="+", color="#2E6B38", penwidth=2.5, comment="[Brooke Granger - B1] Higher frontline supply increases referral completion (WHO 2022)"];
  specialty_care_referral_availability -> policy_advocacy [label="-", style="dashed", color="#244C6A", penwidth=2.0, comment="[Brooke Granger - B1] Better referral access may reduce pressure for policy advocacy over time. ACOG (2023) provides context on provider capacity; this proposed link needs direct evidence."];
  policy_advocacy -> state_scope_of_practice_laws [label="+ (delay)", style="dashed", color="#2E6B38", penwidth=2.5, comment="[Brooke Granger - B1] Advocacy for expanded access may lead to more permissive scope-of-practice laws. The outcome is uncertain and policy change may take time."];

  // LOOP R2 (Sienna Hernandez)
  income_security -> difficulty_raising_funds [label="-", color="#5B50A5", penwidth=2.5, comment="[Sienna Hernandez - R2] Lower financial resources plausibly increase financing difficulty. Difficulty meeting basic expenses was associated with later presentation [11]; [9] describes payment strategies. Proposed income-to-fundraising mechanism, not an estimated causal effect."];
  difficulty_raising_funds -> abortion_care_delay [label="+", color="#5B50A5", penwidth=2.5, comment="[Sienna Hernandez - R2] Financial barriers were associated with presentation after 10 weeks [11]; commentary [13] explains delays while raising funds. Evidence supports the proposed positive direction, not proof of individual causal effects."];
  abortion_care_delay -> household_out_of_pocket_spending [label="+ (conditional; delay)", style="dashed", color="#244C6A", penwidth=2.0, comment="[Sienna Hernandez - R2] Commentary [13] describes chasing the fee as pregnancy advances. [10] discusses gestation-related costs but does not test delay causing higher payments. Actual spending depends on coverage, aid, method, and obtaining care; retain conditional dashed link."];
  household_out_of_pocket_spending -> income_security [label="- (conditional; delay)", style="dashed", color="#244C6A", penwidth=2.0, comment="[Sienna Hernandez - R2] [9] reports delaying expenses to finance abortion; [10] estimates costs relative to resources after subsistence needs. Supports household financial strain, not proven reduced stable earnings. Return to shared income security remains a conditional hypothesis."];

 
  // LOOP B2 (Arelie Orozco)
  obstetric_maternity_care_availability -> medical_device_availability [label="+", color="#2E6B38", penwidth=2.5, comment="[Arelie Orozco - B2] Active facilities maintain inventory of MVA kits and devices (WHO 2022)"];
  medical_device_availability -> specialty_care_referral_availability [label="+", color="#FFF3E0", penwidth=2.5, comment="[Arelie Orozco - B2] Equipment availability enables procedural referrals (WHO 2025)"];
  specialty_care_referral_availability -> reimbursement_requirements [label="+ (delay)", color="#2E6B38", penwidth=2.5, comment="[Arelie Orozco - B2] High referral volume triggers payer audit mandates (CMS 2023)"];
  reimbursement_requirements -> obstetric_maternity_care_availability [label="- (delay)", color="#2E6B38", penwidth=2.5, comment="[Arelie Orozco - B2] Onerous billing rules erode clinic operating margins (March of Dimes 2023)"];

  // LOOP R3 (Anthony Vuongo)
  health_communication_effectiveness -> out_of_state_travel_burden [label="-", xlabel="R3: Reinforcing loop", color="#E65100", penwidth=2.5, comment="[Anthony Vuongo - R3] Effective public messaging helps navigate legal options (WHO 2025)"];
  out_of_state_travel_burden -> abortion_fund_capacity [label="- (delay)", style="dashed", color="#A52714", penwidth=2.0, comment="[Anthony Vuongo - R3] Surge in travel needs drains local abortion fund reserves (Guttmacher 2023)"];
  abortion_fund_capacity -> household_out_of_pocket_spending [label="-", color="#A52714", penwidth=2.5, comment="[Anthony Vuongo - R3] Higher fund grant capacity reduces out-of-pocket burden (Guttmacher 2023)"];
  household_out_of_pocket_spending -> health_communication_effectiveness [label="- (delay)", style="dashed", color="#244C6A", penwidth=2.5, comment="[Anthony Vuongo - R3] Unexpected costs degrade public trust in health guidance (APHA 2023)"];

  // CONTEXTUAL EDGE
  bundled_payment_use -> household_out_of_pocket_spending [label="+/-", style="dashed", color="#244C6A", comment="Bundled payments offer predictable pricing but require upfront capital (ANSIRH 2024)"];
// Occupational stratification remains a background influence. The unsupported
  // spending-to-occupational-stratification arrow and BLS/CAP placeholders removed.
  occupational_stratification_by_race_gender -> income_security [label="- (hypothesis)", style="dashed", color="#5B50A5", penwidth=2.0, comment="[Sienna Hernandez - Context] Hypothesized effect of concentration in lower-paid insecure work; direct evidence still needed"];
  // Income loss can change eligibility but does not guarantee enrollment.
  income_security -> medicaid_enrollment [label="- (conditional hypothesis)", style="dashed", color="#5B50A5", penwidth=2.0, comment="[Sienna Hernandez - Context] Income-related enrollment pathway depends on eligibility and take-up; [3] provides policy context, not proof of this arrow"];
  medicaid_enrollment -> household_out_of_pocket_spending [label="- (if abortion covered)", style="dashed", color="#244C6A", penwidth=2.0, comment="[Sienna Hernandez - Context] [9] found lower out-of-pocket burdens where state Medicaid covers abortion; [3] explains coverage rules. Enrollment alone is insufficient: service coverage and usable benefits are required. Conditional negative pathway; observational evidence."];
  out_of_state_travel_burden -> difficulty_raising_funds [label="+", color="#A52714", penwidth=2.5, comment="[Sienna Hernandez - Context] Out-of-state travel was associated with greater estimated catastrophic expenditure [10]; geographic and financial barriers were associated with later presentation [11]. Proposed travel-to-financing mechanism, not direct causal proof."];
  abortion_fund_capacity -> difficulty_raising_funds [label="- (if assistance reaches patient)", style="dashed", color="#A52714", penwidth=2.0, comment="[Sienna Hernandez - Context] [13] discusses assistance organizations and funding needs. Hypothesis: aid reaching patients reduces financing gaps; these sources do not estimate the causal effect of aggregate fund capacity."];
  specialty_care_referral_availability -> abortion_care_delay [label="- (if timely/appropriate)", style="dashed", color="#2E6B38", penwidth=2.0, comment="[Sienna Hernandez - Context] Hypothesis: timely appropriate referrals reduce search delays. [11] examines geographic barriers, not referral effectiveness; direct evidence for this particular arrow remains needed."];
}

